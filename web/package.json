{
  "name": "shrinkflation-track-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "test": "node --test tests/*.test.ts",
    "test:browser": "playwright test --config playwright.config.ts",
    "check": "node check-calculations.mjs",
